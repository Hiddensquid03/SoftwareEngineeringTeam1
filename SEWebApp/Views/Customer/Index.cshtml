@model List<SEWebApp.Models.CustomerNoticeViewModel>

@{
    ViewData["Title"] = "Customer Main Page";
}

<link rel="stylesheet" href="~/css/customer.css" />

<div class="customer-page">

    <!-- Header -->
    <div class="customer-header">

        <div class="company-logo">
            ANDtr
        </div>

        <div class="customer-status">
            Logged in as customer
        </div>

    </div>

    <hr />

    <!-- Page heading -->
    <h2>Product Recall Notices</h2>

    <p class="page-description">
        View recall notices shared with your account.
    </p>

    <!-- Search and sorting -->
    <form method="get"
          asp-controller="Customer"
          asp-action="Index"
          class="filter-form">

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               placeholder="Search recall notices..."
               class="search-input" />

        <select name="sort" class="sort-select">

            <option value="newest"
                    selected="@(ViewBag.Sort == "newest")">
                Newest
            </option>

            <option value="oldest"
                    selected="@(ViewBag.Sort == "oldest")">
                Oldest
            </option>

            <option value="comments"
                    selected="@(ViewBag.Sort == "comments")">
                Most Comments
            </option>

            <option value="alphabetical"
                    selected="@(ViewBag.Sort == "alphabetical")">
                Alphabetical
            </option>

        </select>

        <button type="submit" class="filter-button">
            Search / Filter
        </button>

        <a asp-controller="Customer"
           asp-action="Index"
           class="clear-button">
            Clear
        </a>

    </form>

    <!-- Recall notice list -->
    <div class="notice-list">

        @if (Model.Count == 0)
        {
            <p>No matching recall notices found.</p>
        }
        else
        {
            @foreach (var notice in Model)
            {
                <div class="notice-card">

                    <h3>@notice.Title</h3>

                    <p>
                        <strong>Manufacturer:</strong>
                        @notice.Manufacturer
                    </p>

                    <p>
                        <strong>Date:</strong>
                        @notice.NoticeDate.ToString("dd MMM yyyy")
                    </p>

                    <p>@notice.Description</p>

                    <p>
                        Comments: @notice.CommentCount
                    </p>

                </div>
            }
        }

    </div>

</div>
